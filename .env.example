# Backend local somente. Nunca colocar esta chave em JavaScript/HTML.
GEMINI_API_KEY=
# Reservas opcionais: cada chave pertence a um projeto autorizado.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Manter false enquanto público/termos/cota não forem revisados pela equipe.
GEMINI_ENABLED=false
GEMINI_AUDIENCE_REVIEW=pending
GEMINI_FREE_TIER_CONFIRMED=false
# MySQL Community local. O inicializador cria o banco e gera a senha do usuário restrito.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
MYSQL_USER=mannequin_run_app
MYSQL_PASSWORD=
# Nunca coloque a senha administrativa no frontend ou em argumentos de comandos.
LOCAL_PORT=8084
ASSISTANT_PORT=8081
# A revisão é operacional, não uma confirmação de idade pelo visitante.
# Não ativar faturamento; conferir no provedor que o projeto está sem cobrança.
